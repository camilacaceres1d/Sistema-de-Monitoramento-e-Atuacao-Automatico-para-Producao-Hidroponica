<Layouts.app flash={@flash}>
  Sistema de Monitoramento de Hidroponia
  <.table
    id="greenhouses-table"
    rows={@streams.greenhouses}
    row_click={fn {_id, device} -> JS.navigate(~p"/devices/#{device.id}") end}
  >
    <:col :let={{_id, greenhouse}} label="MAC">
      <span>{greenhouse.device_mac}</span>
    </:col>
    <:col :let={{_id, greenhouse}} label="Nome">
      <span>{greenhouse.name}</span>
    </:col>
  </.table>
</Layouts.app>

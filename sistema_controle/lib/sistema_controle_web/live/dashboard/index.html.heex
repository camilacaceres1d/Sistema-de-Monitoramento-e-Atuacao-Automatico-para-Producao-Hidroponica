<Layouts.app flash={@flash}>
  <h1 class="text-2xl font-semibold mb-6">
    Sistema de Monitoramento de Hidroponia
  </h1>
  <div class="bg-base shadow rounded-xl border border-base-200 overflow-hidden">
    <.table
      id="greenhouses-table"
      rows={@streams.greenhouses}
    >
      <:col :let={{_id, item}} label="Nome da Estufa">
        <span class="font-medium">{item.greenhouse.name}</span>
      </:col>
      <:col :let={{_id, item}} label="Cultura">
        <span class="font-medium">{item.greenhouse.crop_name}</span>
      </:col>
      <:col :let={{_id, item}} label="pH">
        <span class={[
          "font-medium px-3 py-1 rounded-md",
          get_status_class(
            item.latest_sensor_data.ph,
            item.greenhouse.min_ph,
            item.greenhouse.ideal_ph,
            item.greenhouse.max_ph
          )
        ]}>
          {format_value(item.latest_sensor_data.ph)}
        </span>
      </:col>
      <:col :let={{_id, item}} label="Temperatura da Água">
        <span class={[
          "font-medium px-3 py-1 rounded-md",
          get_status_class(
            item.latest_sensor_data.water_temperature,
            item.greenhouse.min_water_temp,
            item.greenhouse.ideal_water_temp,
            item.greenhouse.max_water_temp
          )
        ]}>
          {format_value(item.latest_sensor_data.water_temperature)}°C
        </span>
      </:col>
      <:col :let={{_id, item}} label="EC">
        <span class={[
          "font-medium px-3 py-1 rounded-md",
          get_status_class(
            item.latest_sensor_data.ec,
            item.greenhouse.min_ec,
            item.greenhouse.ideal_ec,
            item.greenhouse.max_ec
          )
        ]}>
          {format_value(item.latest_sensor_data.ec)}
        </span>
      </:col>
      <:col :let={{_id, item}} label="Temperatura do Ar">
        <span class={[
          "font-medium px-3 py-1 rounded-md",
          get_status_class(
            item.avg_air_temp,
            item.greenhouse.min_air_temp,
            item.greenhouse.ideal_air_temp,
            item.greenhouse.max_air_temp
          )
        ]}>
          {format_value(item.avg_air_temp)}°C
        </span>
      </:col>
      <:col :let={{_id, item}} label="Umidade do Ar">
        <span class={[
          "font-medium px-3 py-1 rounded-md",
          get_status_class(
            item.avg_air_humidity,
            item.greenhouse.min_air_humidity,
            item.greenhouse.ideal_air_humidity,
            item.greenhouse.max_air_humidity
          )
        ]}>
          {format_value(item.avg_air_humidity)}%
        </span>
      </:col>
      <:col :let={{_id, item}} label="Estado da Bomba">
        <span class={[
          "font-semibold",
          if(item.latest_sensor_data.pump_state, do: "text-green-600", else: "text-red-600")
        ]}>
          {if item.latest_sensor_data.pump_state, do: "Ligada", else: "Desligada"}
        </span>
      </:col>
      <:action :let={{_id, item}}>
        <.button phx-click={JS.navigate(~p"/devices/#{item.greenhouse.device.id}")}>
          <.icon name="hero-magnifying-glass" class="h-5 w-5" />
        </.button>
      </:action>
    </.table>
  </div>
</Layouts.app>
